# Copy this file to deploy/pi/env and fill in the values.
# Never commit deploy/pi/env - it is gitignored.

# Mistral API key (console.mistral.ai), so the worker can register with the platform.
MISTRAL_API_KEY=

# planets.nu API key of the account lomize.
PLANETSNU_API_KEY=

# Deployment name under which this worker registers (keep stable).
DEPLOYMENT_NAME=diana-planets-api

# Optional: name of this worker in the console (defaults to hostname).
# WORKER_NAME=raspi-diana
